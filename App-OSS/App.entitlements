<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Host app is unsandboxed so it can drive diskutil (First Aid, Format,
	     eject) like every competitor NTFS app. The FSKit module keeps its own
	     mandatory sandbox - this only affects the UI app. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
